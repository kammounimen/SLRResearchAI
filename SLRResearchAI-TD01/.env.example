# CHOIX DU FOURNISSEUR
# ollama : modèle local, données conservées sur la machine, fonctionne hors-ligne
#          après téléchargement du modèle ; nécessite Ollama et assez de ressources.
# groq   : API distante, démarrage rapide et calcul déporté ; nécessite Internet
#          et une clé GROQ_API_KEY. Ne pas envoyer de données confidentielles.
LLM_PROVIDER=ollama

# Utilisé uniquement lorsque LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Utilisés uniquement lorsque LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
